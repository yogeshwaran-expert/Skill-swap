# ============================================
# Skill Swap — Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# --- Database (PostgreSQL) ---
POSTGRES_DB=skillswap
POSTGRES_USER=skillswap
POSTGRES_PASSWORD=skillswap_dev
DATABASE_URL=jdbc:postgresql://localhost:5432/skillswap

# --- JWT ---
JWT_SECRET=super-secret-dev-key-change-in-production-min-32-chars!!
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Frontend ---
VITE_API_URL=http://localhost:8080

# --- File Storage ---
# LOCAL or S3 (only LOCAL is implemented for dev)
FILE_STORAGE_TYPE=LOCAL
FILE_STORAGE_PATH=./uploads
